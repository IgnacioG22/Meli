@IsTest
private class LeadSyncSchedulerTest {

    @TestSetup
    static void setup() {
        insert new Lead_Sync_Cursor__c(
            Name = 'Main Cursor',
            Last_Processed_Date__c = DateTime.newInstance(2026, 1, 1, 12, 0, 0),
            IsRunning__c = false
        );
        insert buildTestUser();
    }

    @IsTest
    static void encolaQueueableCuandoNoHayProcesoCorriendo() {
        resetQueueableHooks();
        User testUser = getTestUser();

        LeadSyncQueueable.TEST_MODE = true;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = true;
        LeadSyncQueueable.TEST_SKIP_UPSERT = true;
        LeadSyncQueueable.TEST_NEXT_AVAILABLE_DATE = null;

        System.runAs(testUser) {
            Test.startTest();
            new LeadSyncScheduler().execute(null);
            Test.stopTest();
        }

        Integer jobs = [
            SELECT Count()
            FROM AsyncApexJob
            WHERE JobType = 'Queueable'
            AND ApexClass.Name = 'LeadSyncQueueable'
        ];

        Lead_Sync_Cursor__c cursor = [
            SELECT IsRunning__c
            FROM Lead_Sync_Cursor__c
            WHERE Name = 'Main Cursor'
            LIMIT 1
        ];

        System.assertEquals(1, jobs, 'El scheduler debe encolar un queueable.');
        System.assertEquals(
            false,
            cursor.IsRunning__c,
            'El queueable de prueba debe liberar el lock al finalizar.'
        );
    }

    @IsTest
    static void noEncolaSiYaHayProcesoCorriendo() {
        resetQueueableHooks();
        User testUser = getTestUser();

        Lead_Sync_Cursor__c cursor = [
            SELECT Id, IsRunning__c
            FROM Lead_Sync_Cursor__c
            WHERE Name = 'Main Cursor'
            LIMIT 1
        ];
        cursor.IsRunning__c = true;
        update cursor;

        System.runAs(testUser) {
            Test.startTest();
            new LeadSyncScheduler().execute(null);
            Test.stopTest();
        }

        Integer jobs = [
            SELECT Count()
            FROM AsyncApexJob
            WHERE JobType = 'Queueable'
            AND ApexClass.Name = 'LeadSyncQueueable'
        ];

        Lead_Sync_Cursor__c refreshed = [
            SELECT IsRunning__c
            FROM Lead_Sync_Cursor__c
            WHERE Name = 'Main Cursor'
            LIMIT 1
        ];

        System.assertEquals(0, jobs, 'No debe encolar nada si el proceso ya esta corriendo.');
        System.assertEquals(true, refreshed.IsRunning__c);
    }

    @IsTest
    static void liberaLockSiEnqueueFalla() {
        resetQueueableHooks();
        User testUser = getTestUser();
        LeadSyncScheduler.TEST_FORCE_ENQUEUE_EXCEPTION = true;

        System.runAs(testUser) {
            Test.startTest();
            try {
                new LeadSyncScheduler().execute(null);
                System.assert(false, 'Debio lanzar una excepcion.');
            } catch (Exception e) {
                System.assertNotEquals(null, e);
            }
            Test.stopTest();
        }

        Lead_Sync_Cursor__c cursor = [
            SELECT IsRunning__c
            FROM Lead_Sync_Cursor__c
            WHERE Name = 'Main Cursor'
            LIMIT 1
        ];

        System.assertEquals(false, cursor.IsRunning__c);
    }

    private static void resetQueueableHooks() {
        LeadSyncQueueable.TEST_MODE = false;
        LeadSyncQueueable.TEST_NEXT_AVAILABLE_DATE = null;
        LeadSyncQueueable.TEST_PROBE_ROWS = null;
        LeadSyncQueueable.TEST_PREFIX_ROWS = null;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = false;
        LeadSyncQueueable.TEST_SKIP_UPSERT = false;
        LeadSyncQueueable.TEST_ROW_MAPS = null;
        LeadSyncQueueable.TEST_CAPTURED_LEADS_WITH_SELLER = null;
        LeadSyncQueueable.TEST_CAPTURED_LEADS_WITHOUT_SELLER = null;
        LeadSyncScheduler.TEST_FORCE_ENQUEUE_EXCEPTION = false;
    }

    private static User buildTestUser() {
        String unique = String.valueOf(DateTime.now().getTime());
        User testUser = new User(
            Alias = 'tusr',
            Email = 'testuser+' + unique + '@example.com',
            EmailEncodingKey = 'UTF-8',
            LastName = 'Test',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            ProfileId = UserInfo.getProfileId(),
            TimeZoneSidKey = 'America/Los_Angeles',
            UserName = 'testuser+' + unique + '@example.com'
        );

        applyOrgSpecificUserDefaults(testUser);
        return testUser;
    }

    private static User getTestUser() {
        return [SELECT Id FROM User WHERE Alias = 'tusr' LIMIT 1];
    }

    private static void applyOrgSpecificUserDefaults(User testUser) {
        Map<String, Schema.SObjectField> userFields = Schema.SObjectType.User.fields.getMap();
        if (!userFields.containsKey('Business_Unit__c')) {
            return;
        }

        Schema.DescribeFieldResult fieldDescribe = userFields.get('Business_Unit__c').getDescribe();
        if (fieldDescribe.getType() == Schema.DisplayType.Picklist) {
            for (Schema.PicklistEntry entry : fieldDescribe.getPicklistValues()) {
                if (entry.isActive()) {
                    testUser.put('Business_Unit__c', entry.getValue());
                    return;
                }
            }
        }

        testUser.put('Business_Unit__c', 'Default');
    }
}
