    @IsTest
    static void procesaRowsEnModoNormalYConstruyeLeadsEsperados() {
        resetHooks();
        setCursor(Date.newInstance(2026, 1, 1), '');
        User testUser = getTestUser();

        LeadSyncQueueable.TEST_MODE = true;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = true;
        LeadSyncQueueable.TEST_SKIP_UPSERT = true;
        LeadSyncQueueable.TEST_NEXT_AVAILABLE_DATE = Date.newInstance(2026, 1, 5);
        LeadSyncQueueable.TEST_PROBE_ROWS = buildDummyRows(2);
        LeadSyncQueueable.TEST_ROW_MAPS = new List<Map<String, Object>>{
            new Map<String, Object>{
                'uuid__c' => 'uuid-1',
                'nombre__c' => 'Fernanda Lead',
                'correo__c' => 'fernanda@example.com',
                'telefono__c' => '111111',
                'seller_id__c' => Decimal.valueOf('123.0'),
                'categoria__c' => 'Hogar y Muebles',
                'etapa_funnel__c' => 'Nuevo',
                'madurez_digital__c' => 'Alta',
                'tier__c' => 'Tier 1'
            },
            new Map<String, Object>{
                'uuid__c' => 'uuid-2',
                'nombre__c' => null,
                'correo__c' => 'sinvendedor@example.com',
                'telefono__c' => '222222',
                'seller_id__c' => null,
                'categoria__c' => 'General',
                'etapa_funnel__c' => 'Contacto',
                'madurez_digital__c' => 'Media',
                'tier__c' => 'Tier 4'
            }
        };

        System.runAs(testUser) {
            Test.startTest();
            new LeadSyncQueueable().execute(null);
            Test.stopTest();
        }

        System.assertEquals(1, LeadSyncQueueable.TEST_CAPTURED_LEADS_WITH_SELLER.size());
        System.assertEquals(1, LeadSyncQueueable.TEST_CAPTURED_LEADS_WITHOUT_SELLER.size());

        Lead conSeller = LeadSyncQueueable.TEST_CAPTURED_LEADS_WITH_SELLER[0];
        Lead sinSeller = LeadSyncQueueable.TEST_CAPTURED_LEADS_WITHOUT_SELLER[0];

        System.assertEquals('uuid-1', conSeller.id_externo_migracion__c);
        System.assertEquals('Fernanda Lead', conSeller.LastName);
        System.assertEquals('123', conSeller.SellerId__c);
        System.assertEquals('123', conSeller.Identification_Number_poc__c);
        System.assertEquals('0053t00000B9b7MAAR', conSeller.OwnerId);

        System.assertEquals('uuid-2', sinSeller.id_externo_migracion__c);
        System.assertEquals('Sin Nombre', sinSeller.LastName);
        System.assertEquals(null, sinSeller.SellerId__c);
        System.assertEquals('005Pc000000hN9RIAU', sinSeller.OwnerId);
        System.assertEquals(Date.newInstance(2026, 1, 6), LeadSyncCursor.getLastDate().date());
    }

    @IsTest
    static void procesaRowsEnModoPrefijoYAvanzaAlSiguientePrefijo() {
        resetHooks();
        setCursor(Date.newInstance(2026, 1, 5), 'PFX:a');
        User testUser = getTestUser();

        LeadSyncQueueable.TEST_MODE = true;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = true;
        LeadSyncQueueable.TEST_SKIP_UPSERT = true;
        LeadSyncQueueable.TEST_PREFIX_ROWS = buildDummyRows(3);
        LeadSyncQueueable.TEST_ROW_MAPS = new List<Map<String, Object>>{
            new Map<String, Object>{
                'uuid__c' => 'uuid-a1',
                'nombre__c' => 'Lead A1',
                'correo__c' => 'a1@example.com',
                'telefono__c' => '333333',
                'seller_id__c' => '200.0',
                'categoria__c' => 'General',
                'etapa_funnel__c' => 'Nuevo',
                'madurez_digital__c' => 'Baja',
                'tier__c' => 'Tier 3'
            },
            new Map<String, Object>{
                'uuid__c' => 'uuid-a2',
                'nombre__c' => 'Lead A2',
                'correo__c' => 'a2@example.com',
                'telefono__c' => '444444',
                'seller_id__c' => null,
                'categoria__c' => 'General',
                'etapa_funnel__c' => 'Nuevo',
                'madurez_digital__c' => 'Baja',
                'tier__c' => 'Tier 3'
            },
            new Map<String, Object>{
                'uuid__c' => 'uuid-a3',
                'nombre__c' => 'Lead A3',
                'correo__c' => 'a3@example.com',
                'telefono__c' => '555555',
                'seller_id__c' => '300',
                'categoria__c' => 'General',
                'etapa_funnel__c' => 'Nuevo',
                'madurez_digital__c' => 'Baja',
                'tier__c' => 'Tier 3'
            }
        };

        System.runAs(testUser) {
            Test.startTest();
            new LeadSyncQueueable().execute(null);
            Test.stopTest();
        }

        System.assertEquals(2, LeadSyncQueueable.TEST_CAPTURED_LEADS_WITH_SELLER.size());
        System.assertEquals(1, LeadSyncQueueable.TEST_CAPTURED_LEADS_WITHOUT_SELLER.size());

        System.assertEquals('200', LeadSyncQueueable.TEST_CAPTURED_LEADS_WITH_SELLER[0].SellerId__c);
        System.assertEquals('005Pc000000hN9RIAU', LeadSyncQueueable.TEST_CAPTURED_LEADS_WITH_SELLER[0].OwnerId);
        System.assertEquals('0053t000008nvJAAAY', LeadSyncQueueable.TEST_CAPTURED_LEADS_WITHOUT_SELLER[0].OwnerId);
        System.assertEquals('005Pc000009wzU9IAI', LeadSyncQueueable.TEST_CAPTURED_LEADS_WITH_SELLER[1].OwnerId);
        System.assertEquals(Date.newInstance(2026, 1, 5), LeadSyncCursor.getLastDate().date());
        System.assertEquals('PFX:b', LeadSyncCursor.getLastUUID());
    }

    @IsTest
    static void liberaLockCuandoNoHayMasFechasParaProcesar() {
        resetHooks();
        setCursor(Date.newInstance(2026, 1, 5), '');
        User testUser = getTestUser();

        LeadSyncQueueable.TEST_MODE = true;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = true;
        LeadSyncQueueable.TEST_SKIP_UPSERT = true;
        LeadSyncQueueable.TEST_NEXT_AVAILABLE_DATE = null;

        Lead_Sync_Cursor__c cursor = [
            SELECT Id, IsRunning__c
            FROM Lead_Sync_Cursor__c
            WHERE Name = 'Main Cursor'
            LIMIT 1
        ];
        cursor.IsRunning__c = true;
        update cursor;

        System.runAs(testUser) {
            Test.startTest();
            new LeadSyncQueueable().execute(null);
            Test.stopTest();
        }

        Lead_Sync_Cursor__c refreshed = [
            SELECT Id, IsRunning__c
            FROM Lead_Sync_Cursor__c
            WHERE Id = :cursor.Id
        ];
        System.assertEquals(false, refreshed.IsRunning__c);
    }

    @IsTest
    static void liberaLockYLanzaErrorSiElSubbucketMasProfundoSigueLleno() {
        resetHooks();
        setCursor(Date.newInstance(2026, 1, 5), 'PFX:ff');
        User testUser = getTestUser();

        LeadSyncQueueable.TEST_MODE = true;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = true;
        LeadSyncQueueable.TEST_SKIP_UPSERT = true;
        LeadSyncQueueable.TEST_PREFIX_ROWS = buildDummyRows(2000);

        Lead_Sync_Cursor__c cursor = [
            SELECT Id, IsRunning__c
            FROM Lead_Sync_Cursor__c
            WHERE Name = 'Main Cursor'
            LIMIT 1
        ];
        cursor.IsRunning__c = true;
        update cursor;

        System.runAs(testUser) {
            Test.startTest();
            try {
                new LeadSyncQueueable().execute(null);
                System.assert(false, 'Debio lanzar una AuraHandledException.');
            } catch (AuraHandledException e) {
                System.assertNotEquals(null, e);
            }
            Test.stopTest();
        }

        Lead_Sync_Cursor__c refreshed = [
            SELECT Id, IsRunning__c
            FROM Lead_Sync_Cursor__c
            WHERE Id = :cursor.Id
        ];
        System.assertEquals(false, refreshed.IsRunning__c);
    }

    private static void setCursor(Date cursorDate, String token) {
        LeadSyncCursor.updateCursor(
            DateTime.newInstance(cursorDate, Time.newInstance(12, 0, 0, 0)),
            token
        );
    }

    private static void resetHooks() {
        LeadSyncQueueable.TEST_MODE = false;
        LeadSyncQueueable.TEST_NEXT_AVAILABLE_DATE = null;
        LeadSyncQueueable.TEST_PROBE_ROWS = null;
        LeadSyncQueueable.TEST_PREFIX_ROWS = null;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = false;
        LeadSyncQueueable.TEST_SKIP_UPSERT = false;
        LeadSyncQueueable.TEST_ROW_MAPS = null;
        LeadSyncQueueable.TEST_CAPTURED_LEADS_WITH_SELLER = null;
        LeadSyncQueueable.TEST_CAPTURED_LEADS_WITHOUT_SELLER = null;
    }

    private static List<SObject> buildDummyRows(Integer size) {
        List<SObject> rows = new List<SObject>();
        for (Integer i = 0; i < size; i++) {
            rows.add(new Lead_Sync_Cursor__c(Name = 'Dummy ' + i));
        }
        return rows;
    }

    private static User buildTestUser() {
        String unique = String.valueOf(DateTime.now().getTime());
        User testUser = new User(
            Alias = 'tusr',
            Email = 'testuser+' + unique + '@example.com',
            EmailEncodingKey = 'UTF-8',
            LastName = 'Test',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            ProfileId = UserInfo.getProfileId(),
            TimeZoneSidKey = 'America/Los_Angeles',
            UserName = 'testuser+' + unique + '@example.com'
        );

        applyOrgSpecificUserDefaults(testUser);
        return testUser;
    }

    private static User getTestUser() {
        return [SELECT Id FROM User WHERE Alias = 'tusr' LIMIT 1];
    }

    private static void applyOrgSpecificUserDefaults(User testUser) {
        Map<String, Schema.SObjectField> userFields = Schema.SObjectType.User.fields.getMap();
        if (!userFields.containsKey('Business_Unit__c')) {
            return;
        }

        Schema.DescribeFieldResult fieldDescribe = userFields.get('Business_Unit__c').getDescribe();
        if (fieldDescribe.getType() == Schema.DisplayType.Picklist) {
            for (Schema.PicklistEntry entry : fieldDescribe.getPicklistValues()) {
                if (entry.isActive()) {
                    testUser.put('Business_Unit__c', entry.getValue());
                    return;
                }
            }
        }

        testUser.put('Business_Unit__c', 'Default');
    }
}
