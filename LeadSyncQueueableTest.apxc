@IsTest
private class LeadSyncQueueableTest {

    @TestSetup
    static void setupData() {
        insert new Lead_Sync_Cursor__c(
            Name = 'Main Cursor',
            Last_Processed_Date__c = DateTime.newInstance(2026, 1, 1, 12, 0, 0),
            IsRunning__c = false
        );
        insert buildTestUser();
    }

    @IsTest
    static void avanzaAlSiguienteDiaCuandoNoHayRowsEnElDia() {
        resetHooks();
        setCursor(Date.newInstance(2026, 1, 1), '');
        User testUser = getTestUser();

        LeadSyncQueueable.TEST_MODE = true;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = true;
        LeadSyncQueueable.TEST_SKIP_UPSERT = true;
        LeadSyncQueueable.TEST_NEXT_AVAILABLE_DATE = Date.newInstance(2026, 1, 5);
        LeadSyncQueueable.TEST_PROBE_ROWS = new List<SObject>();

        System.runAs(testUser) {
            Test.startTest();
            new LeadSyncQueueable().execute(null);
            Test.stopTest();
        }

        System.assertEquals(Date.newInstance(2026, 1, 6), LeadSyncCursor.getLastDate().date());
        System.assert(String.isBlank(LeadSyncCursor.getLastUUID()));
    }

    @IsTest
    static void entraEnModoPrefijosCuandoElChunkLlegaAlLimite() {
        resetHooks();
        setCursor(Date.newInstance(2026, 1, 1), '');
        User testUser = getTestUser();

        LeadSyncQueueable.TEST_MODE = true;
        LeadSyncQueueable.TEST_DISABLE_REQUEUE = true;
        LeadSyncQueueable.TEST_SKIP_UPSERT = true;
        LeadSyncQueueable.TEST_NEXT_AVAILABLE_DATE = Date.newInstance(2026, 1, 5);
        LeadSyncQueueable.TEST_PROBE_ROWS = buildDummyRows(2000);

        System.runAs(testUser) {
            Test.startTest();
            new LeadSyncQueueable().execute(null);
            Test.stopTest();
        }

        System.assertEquals(Date.newInstance(2026, 1, 5), LeadSyncCursor.getLastDate().date());
        System.assertEquals('PFX:0', LeadSyncCursor.getLastUUID());
    }

